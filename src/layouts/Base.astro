---
import { ClientRouter } from "astro:transitions";
import archivo from "@/assets/fonts/Archivo-latin.woff2?url";
import jetBrainsMono from "@/assets/fonts/JetBrainsMono-latin.woff2?url";
import Footer from "@/components/layout/Footer.astro";
import Header from "@/components/layout/Header.astro";
import type { PageMetadata } from "@/lib/metadata";
import { websiteJsonLd } from "@/lib/seo";
import { absoluteUrl, siteName } from "@/lib/site";
import "@/styles/global.css";

type Props = { metadata: PageMetadata };
const { metadata } = Astro.props;
const social = metadata.openGraph;
const image = absoluteUrl(social.image.url);
const jsonLd = JSON.stringify(websiteJsonLd).replace(/</g, "\\u003c");
---
<!doctype html>
<html lang="en" class="h-full antialiased" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ClientRouter fallback="swap" />
    <title>{metadata.title}</title>
    <meta name="description" content={metadata.description} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#070a11" />
    {metadata.noindex && <meta name="robots" content="noindex" />}
    {metadata.canonical && <link rel="canonical" href={absoluteUrl(metadata.canonical)} />}
    <link rel="describedby" href="/llms.txt" />
    {metadata.markdown && <link rel="alternate" type="text/markdown" href={absoluteUrl(metadata.markdown)} />}
    {metadata.authors?.map((author) => <><meta name="author" content={author.name} /><link rel="author" href={author.url} /></>)}
    <meta property="og:title" content={social.title} />
    <meta property="og:description" content={social.description} />
    <meta property="og:url" content={absoluteUrl(social.url)} />
    <meta property="og:type" content={social.type} />
    {metadata.canonical === "/" && <><meta property="og:site_name" content={siteName} /><meta property="og:locale" content="en_US" /></>}
    <meta property="og:image" content={image} />
    {social.image.type && <meta property="og:image:type" content={social.image.type} />}
    <meta property="og:image:width" content={String(social.image.width)} />
    <meta property="og:image:height" content={String(social.image.height)} />
    <meta property="og:image:alt" content={social.image.alt} />
    {social.publishedTime && <meta property="article:published_time" content={social.publishedTime} />}
    {social.authors?.map((author) => <meta property="article:author" content={author} />)}
    {social.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={social.title} />
    <meta name="twitter:description" content={social.description} />
    <meta name="twitter:image" content={image} />
    {social.image.type && <meta name="twitter:image:type" content={social.image.type} />}
    <meta name="twitter:image:width" content={String(social.image.width)} />
    <meta name="twitter:image:height" content={String(social.image.height)} />
    <meta name="twitter:image:alt" content={social.image.alt} />
    <link rel="manifest" href="/manifest.json" crossorigin="use-credentials" />
    <link rel="icon" href="/favicon.ico" sizes="256x256" type="image/x-icon" />
    {[16, 32, 96].map((size) => <link rel="icon" href={`/favicon-${size}x${size}.png`} sizes={`${size}x${size}`} type="image/png" />)}
    <link rel="icon" href="/android-icon-192x192.png" sizes="192x192" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-icon-180x180.png" sizes="180x180" type="image/png" />
    <meta name="msapplication-TileColor" content="#070a11" />
    <meta name="msapplication-TileImage" content="/ms-icon-144x144.png" />
    <link rel="preload" href={archivo} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={jetBrainsMono} as="font" type="font/woff2" crossorigin />
  </head>
  <body class="flex min-h-dvh flex-col bg-bg font-body text-foreground wrap-anywhere">
    <script type="application/ld+json" set:html={jsonLd} />
    <a class="skip-link" href="#main-content" data-astro-reload>Skip to content</a>
    <Header pathname={Astro.url.pathname} />
    <main id="main-content" class="grow flex flex-col" style="view-transition-name:page-content"><slot /></main>
    <Footer />
    <script>
      import { initBrowser } from "@/scripts/browser";
      initBrowser();
    </script>
  </body>
</html>
