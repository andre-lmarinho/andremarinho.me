---
import Icon from "@/components/ui/Icon.astro";

type Props = {
  index: string;
  label: string;
  link: { href: string; label: string };
};
const { index, label, link } = Astro.props;
const labelClass = "text-[10px] uppercase tracking-[0.2em]";
---
<div class="mb-8 flex flex-wrap items-center gap-x-3 gap-y-3">
  <span class={`${labelClass} text-muted tabular-nums`}>{index}</span>
  <h2 class={`${labelClass} shrink-0 text-foreground`}>{label}</h2>

  <span aria-hidden="true" class="block h-px flex-1 bg-border" />

  <a
    href={link.href}
    class={`${labelClass} group inline-flex shrink-0 items-center gap-x-1.5 text-muted transition-colors hover:text-accent`}
  >
    {link.label}
    <Icon
      name="arrow-right"
      class="h-3 w-3 transition-transform group-hover:translate-x-0.5"
      aria-hidden="true"
    />
  </a>
</div>
