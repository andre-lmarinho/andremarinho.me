---
import Image from "@/components/ui/ResponsiveImage.astro";
import type { Project } from "@/lib/projects";

type Props = { project: Project };
const { project } = Astro.props;
---

<section
  class="project-images mt-8 sm:mt-10"
  aria-label={`${project.title} image`}
>
  <figure>
    <Image
      src={project.image.src}
      alt={project.image.alt}
      sizes="(min-width: 1024px) 704px, (min-width: 768px) 720px, calc(100vw - 48px)"
      style={`view-transition-name:project-image-${project.slug}`}
      class="block h-auto w-full rounded-md border border-border"
      priority
    />
  </figure>
</section>

<style>
.project-images {
  --image-inset: max(
    var(--page-gutter),
    calc((100% - var(--page-width)) / 2 + var(--page-gutter))
  );
  padding-inline: var(--image-inset);
}

figure {
  margin: 0;
  min-width: 0;
  padding-block: 0.375rem;
}
</style>
