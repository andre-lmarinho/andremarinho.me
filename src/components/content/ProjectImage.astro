---
import Image from "@/components/ui/ResponsiveImage.astro";
import type { Project } from "@/lib/projects";

type Props = { project: Project };
const { project } = Astro.props;
const multiple = project.images.length > 1;
---

<section
  class="project-images mt-8 sm:mt-10"
  data-carousel={multiple || undefined}
  aria-label={`${project.title} images`}
>
  <div class="image-track" tabindex={multiple ? "0" : undefined}>
    {project.images.map(({ src, alt, caption }, index) => (
      <figure>
        <Image
          src={src}
          alt={alt}
          sizes="(min-width: 1024px) 704px, (min-width: 768px) 720px, calc(100vw - 48px)"
          style={
            index === 0
              ? `view-transition-name:project-image-${project.slug}`
              : undefined
          }
          class="block h-auto w-full rounded-md border border-border"
          priority={index === 0}
        />
        {caption && (
          <figcaption class="mt-3 text-xs leading-relaxed text-muted">
            {caption}
          </figcaption>
        )}
      </figure>
    ))}
  </div>
</section>

<style>
.project-images {
  --image-inset: max(
    var(--page-gutter),
    calc((100% - var(--page-width)) / 2 + var(--page-gutter))
  );
}

.image-track {
  display: flex;
  gap: 1.5rem;
  padding: 0.375rem var(--image-inset);
}

figure {
  flex: 0 0 100%;
  min-width: 0;
}

[data-carousel] .image-track {
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scroll-padding-inline: var(--image-inset);
  scrollbar-width: none;
}

[data-carousel] .image-track::-webkit-scrollbar {
  display: none;
}

[data-carousel] figure {
  flex-basis: min(
    calc(var(--page-width) - 2 * var(--page-gutter)),
    calc(100vw - 3 * var(--page-gutter))
  );
  scroll-snap-align: start;
}

.image-track:focus-visible {
  outline: 2px solid var(--color-accent);
  outline-offset: -2px;
}

@media (prefers-reduced-motion: no-preference) {
  .image-track {
    scroll-behavior: smooth;
  }
}
</style>
