---
import MorphTitle from "@/components/motion/MorphTitle.astro";
import { postCounter } from "@/lib/abacus";
import { formatShortDate } from "@/lib/content";
import type { Post } from "@/lib/posts";

type Props = { posts: Post[]; titleAs?: "h2" | "h3" };
const { posts, titleAs = "h3" } = Astro.props;
---

<ol class="content-list mt-4 flex flex-col">
  {posts.map((post) => (
    <li>
      <a
        href={`/posts/${post.slug}`}
        class="content-row group -mx-2 p-2 flex flex-col gap-1.5 rounded-md sm:flex-row sm:gap-6"
      >
        <time
          datetime={post.date || undefined}
          class="text-xs leading-6 text-muted sm:w-28 sm:shrink-0"
        >
          {post.date ? formatShortDate(post.date) : "Draft"}
        </time>
        <div class="flex min-w-0 flex-1 items-baseline justify-between gap-4">
          <MorphTitle
            as={titleAs}
            title={post.title}
            id={`post-${post.slug}`}
            class="text-base leading-6 font-medium transition-colors group-hover:text-accent"
          />
          <span
            title="Post views"
            class="shrink-0 text-xs text-faint tabular-nums"
            data-post-counter={postCounter(post.slug)}
          >
            … views
          </span>
        </div>
      </a>
    </li>
  ))}
</ol>
