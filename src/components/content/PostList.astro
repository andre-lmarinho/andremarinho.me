---
import MorphTitle from "@/components/motion/MorphTitle.astro";
import { formatShortDate } from "@/lib/content";
import type { Post } from "@/lib/posts";

type Props = { posts: Post[]; titleAs?: "h2" | "h3" };
const { posts, titleAs = "h3" } = Astro.props;
---

<ol class="content-list mt-4 flex flex-col">
  {posts.map((post) => (
    <li>
      <a
        href={`/posts/${post.slug}`}
        class="content-row group -mx-2 flex flex-wrap items-baseline gap-x-4 gap-y-1 rounded-md p-2 sm:flex-nowrap"
      >
        <MorphTitle
          as={titleAs}
          title={post.title}
          id={`post-${post.slug}`}
          class="w-full min-w-0 truncate text-base leading-6 font-medium transition-colors group-hover:text-accent sm:w-auto"
        />
        <time
          datetime={post.date || undefined}
          class="text-xs leading-5 text-muted sm:-order-1 sm:mr-2 sm:w-24 sm:shrink-0 sm:self-start sm:leading-6"
        >
          {post.date ? formatShortDate(post.date) : "Draft"}
        </time>
        <span
          title="Post views"
          class="ml-auto shrink-0 text-xs text-faint tabular-nums"
          data-post-counter={post.slug}
        ></span>
      </a>
    </li>
  ))}
</ol>
