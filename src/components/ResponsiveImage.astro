---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { HTMLAttributes } from "astro/types";

type Props = Omit<HTMLAttributes<"img">, "src" | "width" | "height"> & {
  src: string;
  alt: string;
  width: number;
  height: number;
  sizes: string;
};
const { src, ...props } = Astro.props;
const images = import.meta.glob<ImageMetadata>(
  "/public/images/**/*.{avif,jpeg,jpg,png,webp}",
  { eager: true, import: "default" },
);
const image = images[`/public${src}`];
if (!image) throw new Error(`Image not found: ${src}`);
---
<Picture
  src={image}
  formats={["avif"]}
  fallbackFormat="webp"
  widths={[96, 128, 256, 384, 640, 750, 828, 1080, 1200, 1920]}
  pictureAttributes={{ style: "display:contents", class: "[&>source]:hidden" }}
  {...props}
/>
