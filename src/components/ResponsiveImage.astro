---
import type { HTMLAttributes } from "astro/types";
import { responsiveImageProps } from "@/lib/images";

type Props = Omit<HTMLAttributes<"img">, "src" | "width" | "height"> & {
  src: string;
  alt: string;
  width: number;
  height: number;
};
const {
  src,
  alt,
  width,
  height,
  loading = "lazy",
  decoding = "async",
  style,
  ...props
} = Astro.props;
const { avifSrcset, ...image } = responsiveImageProps(src, width);
---
<picture style="display:contents">
  {avifSrcset && <source hidden type="image/avif" srcset={avifSrcset} sizes={props.sizes} />}
  <img {...image} alt={alt} width={width} height={height} loading={loading} decoding={decoding} {...props} style={typeof style === "object" ? { color: "transparent", ...style } : `color:transparent;${style ?? ""}`} />
</picture>
