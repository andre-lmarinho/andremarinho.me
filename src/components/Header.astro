---
type Props = { pathname: string };
const { pathname } = Astro.props;
const path = pathname.replace(/\/$/, "") || "/";
const routes = [
  { label: "home", href: "/" },
  { label: "about", href: "/about" },
  { label: "projects", href: "/projects" },
  { label: "posts", href: "/posts" },
];
---
<header class="site-header sticky top-0 z-40">
  <div class="mx-auto flex min-h-16 w-full max-w-3xl items-center justify-between px-6 lg:px-8">
    <nav aria-label="Site">
      <ul class="flex flex-wrap gap-x-5 text-sm">
        {routes.map(({ label, href }) => {
          const active = href === "/" ? path === "/" : path === href || path.startsWith(`${href}/`);
          return <li><a href={href} data-astro-prefetch="load" aria-current={active ? path === href ? "page" : "true" : undefined} class={`inline-flex min-h-11 items-center transition-colors hover:text-accent ${active ? "text-foreground underline decoration-accent underline-offset-8" : "text-muted"}`}>{label}</a></li>;
        })}
      </ul>
    </nav>
  </div>
</header>
