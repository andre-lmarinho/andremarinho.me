---
type Props = { pathname: string };
const { pathname } = Astro.props;
const path = pathname.replace(/\/$/, "") || "/";
const routes = [
  { label: "home", href: "/" },
  { label: "about", href: "/about" },
  { label: "projects", href: "/projects" },
  { label: "posts", href: "/posts" },
];
---

<header
  class="site-header sticky top-0 z-40 bg-bg/82 backdrop-blur-lg backdrop-saturate-140 after:pointer-events-none after:absolute after:inset-x-0 after:top-full after:h-10 after:bg-linear-to-b after:from-bg after:to-transparent after:content-[''] print:static print:bg-transparent print:backdrop-filter-none print:after:hidden"
>
  <div
    class="mx-auto flex min-h-16 w-full max-w-3xl items-center justify-between px-6 lg:px-8"
  >
    <nav aria-label="Site">
      <ul class="flex flex-wrap gap-x-5 text-sm">
        {routes.map(({ label, href }) => {
          const active =
            href === "/"
              ? path === "/"
              : path === href || path.startsWith(`${href}/`);
          return (
            <li>
              <a
                href={href}
                data-astro-prefetch="load"
                aria-current={
                  active ? (path === href ? "page" : "true") : undefined
                }
                class={`action-link transition-colors hover:text-accent ${active ? "text-foreground underline decoration-accent underline-offset-8" : "text-muted"}`}
              >
                {label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  </div>
</header>

<style>
@keyframes header-material-in {
  from {
    background-color: transparent;
    backdrop-filter: blur(0);
  }
}

@keyframes header-edge-in {
  from {
    opacity: 0;
  }
}

@media screen and (prefers-reduced-motion: no-preference) {
  @supports (animation-timeline: scroll()) {
    .site-header {
      /* Prevent minification into an unsupported animation shorthand. */
      --header-scroll: scroll(root block);
      animation: header-material-in linear both;
      animation-range: 0 50px;
      animation-timeline: var(--header-scroll);
    }

    .site-header::after {
      animation: header-edge-in linear both;
      animation-range: 0 50px;
      animation-timeline: var(--header-scroll);
    }
  }
}
</style>
