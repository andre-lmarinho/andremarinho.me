---
import type { HTMLAttributes } from "astro/types";

type Props = { style?: HTMLAttributes<"h1">["style"] };
const { style } = Astro.props;
---

<!-- biome-ignore lint/a11y/useHeadingContent: Heading content is supplied through the Astro slot. -->
<h1 class="page-heading" style={style}>
  <slot />
</h1>
<div aria-hidden="true" class="mt-8 h-px w-full bg-border" />
