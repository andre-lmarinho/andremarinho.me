---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { HTMLAttributes } from "astro/types";

type Props = Omit<HTMLAttributes<"img">, "src" | "width" | "height"> & {
  src: ImageMetadata;
  alt: string;
  sizes: string;
  priority?: boolean;
};

const { src, ...props } = Astro.props;
---

<Picture
  src={src}
  formats={["avif"]}
  fallbackFormat="webp"
  layout="constrained"
  pictureAttributes={{ style: "display:contents", class: "[&>source]:hidden" }}
  {...props}
/>
