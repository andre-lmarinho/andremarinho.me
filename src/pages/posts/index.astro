---
import PostList from "@/components/content/PostList.astro";
import PageTitle from "@/components/ui/PageTitle.astro";
import Base from "@/layouts/Base.astro";
import { postsMetadata } from "@/lib/metadata";
import { getPosts } from "@/lib/posts";

const posts = await getPosts();
---

<Base metadata={postsMetadata}>
  <section class="mx-auto w-full max-w-3xl px-6 py-16 lg:px-8">
    <PageTitle>Posts</PageTitle>
    <PostList posts={posts} titleAs="h2" />
  </section>
</Base>
