---
import PostList from "@/components/content/PostList.astro";
import ProjectList from "@/components/content/ProjectList.astro";
import SectionRule from "@/components/SectionRule.astro";
import Icon from "@/components/ui/Icon.astro";
import Base from "@/layouts/Base.astro";
import { homeMetadata } from "@/lib/metadata";
import { getPosts } from "@/lib/posts";
import { getProjects } from "@/lib/projects";
import { jobTitle, socials } from "@/lib/site";

const featuredProjects = getProjects().filter((project) => project.featured);
const posts = getPosts().slice(0, 8);
---
<Base metadata={homeMetadata}>
  <section
    id="intro"
    class="flex flex-col mx-auto w-full max-w-3xl px-6 pt-40 pb-28 max-md:pt-32 max-md:pb-20 lg:px-8"
  >
    <h1 class="text-[clamp(38px,5vw,62px)] leading-[1.04] font-semibold tracking-[-0.045em]">
      André Marinho
    </h1>

    <p class="mt-3 text-lg">{jobTitle}</p>

    <p class="mt-4 text-sm text-muted leading-relaxed sm:text-base">
      I build full-stack web products and write down what I learn along the
      way. Away from the screen, there’s room for books, running, classical
      guitar, the beach, and whatever I have just become curious about.
    </p>

    <ul class="mt-9 flex flex-wrap items-center gap-x-6 gap-y-4 text-xs">
      {socials.slice(0, 2).map(({ label, href, icon }) => (
        <li>
          <a
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-x-2 text-muted transition-colors hover:text-accent"
          >
            <Icon name={icon} class="h-3.5 w-3.5" aria-hidden="true" />
            {label}
          </a>
        </li>
      ))}
      <li>
        <a
          href="/about"
          class="group inline-flex items-center gap-x-2 text-muted transition-colors hover:text-accent"
        >
          About Me
          <Icon
            name="arrow-right"
            class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5"
            aria-hidden="true"
          />
        </a>
      </li>
    </ul>
  </section>

  <section
    id="projects"
    class="mx-auto w-full max-w-3xl scroll-mt-24 px-6 pb-28 max-md:pb-20 lg:px-8"
  >
    <SectionRule
      index="01"
      label="projects"
      link={{ href: "/projects", label: "all projects" }}
    />
    <ProjectList projects={featuredProjects} />
  </section>

  <section
    id="writing"
    class="mx-auto w-full max-w-3xl scroll-mt-24 px-6 pb-10 lg:px-8"
  >
    <SectionRule
      index="02"
      label="writing"
      link={{ href: "/posts", label: "all posts" }}
    />
    <PostList posts={posts} />
  </section>
</Base>
