---
import PostList from "@/components/content/PostList.astro";
import ProjectList from "@/components/content/ProjectList.astro";
import Icon from "@/components/ui/Icon.astro";
import Base from "@/layouts/Base.astro";
import { homeMetadata } from "@/lib/metadata";
import { getPosts } from "@/lib/posts";
import { getProject } from "@/lib/projects";
import { jobTitle, socials } from "@/lib/site";

const FEATURED = ["turistar", "create-mvp", "typed-svg-sprite"];

const projects = (await Promise.all(FEATURED.map(getProject))).filter(
  (project) => project !== null,
);
const posts = (await getPosts()).slice(0, 8);
---

<Base metadata={homeMetadata}>
  <section
    id="intro"
    class="mx-auto w-full max-w-3xl px-6 py-16 sm:py-20 lg:px-8 lg:pt-24"
  >
    <h1
      class="text-[clamp(38px,5vw,62px)] leading-[1.04] font-semibold tracking-[-0.045em]"
    >
      André Marinho
    </h1>

    <p class="mt-3 text-lg">{jobTitle}</p>

    <p class="mt-4 text-sm text-muted leading-relaxed sm:text-base">
      I build full-stack web products, drawing on a{" "}
      <a class="text-link" href="/posts/before-i-called-it-code"
        >background in business operations and data</a
      >. I work on{" "}
      <a class="text-link" href="/projects">client projects</a>,{" "}
      <a class="text-link" href="/projects/turistar">my own products</a>, and{" "}
      <a class="text-link" href="/projects/create-mvp">open-source tools</a>,
      from understanding the problem to getting software into production. Away
      from the screen, there’s room for books, running, classical guitar, the
      beach, and whatever I’ve just become curious about.
    </p>

    <ul class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-4 text-xs">
      {socials.slice(0, 2).map(({ label, href, icon }) => (
        <li>
          <a
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-h-11 items-center gap-x-2 text-muted transition-colors hover:text-accent"
          >
            <Icon name={icon} class="h-3.5 w-3.5" aria-hidden="true" />
            {label}
          </a>
        </li>
      ))}
      <li>
        <a
          href="/about"
          class="group inline-flex min-h-11 items-center gap-x-2 text-muted transition-colors hover:text-accent"
        >
          About Me
          <Icon
            name="arrow-right"
            class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5"
            aria-hidden="true"
          />
        </a>
      </li>
    </ul>
  </section>

  <section
    id="projects"
    class="mx-auto w-full max-w-3xl scroll-mt-24 px-6 pb-28 max-md:pb-20 lg:px-8"
  >
    <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-1">
      <h2 class="text-2xl font-semibold">Projects</h2>
      <a href="/projects" class="text-xs text-link">All projects</a>
    </div>
    <ProjectList projects={projects} />
  </section>

  <section
    id="writing"
    class="mx-auto w-full max-w-3xl scroll-mt-24 px-6 pb-10 lg:px-8"
  >
    <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-1">
      <h2 class="text-2xl font-semibold">Writing</h2>
      <a href="/posts" class="text-xs text-link">All posts</a>
    </div>
    <PostList posts={posts} />
  </section>
</Base>
