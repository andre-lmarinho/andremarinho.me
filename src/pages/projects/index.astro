---
import ProjectList from "@/components/content/ProjectList.astro";
import PageTitle from "@/components/ui/PageTitle.astro";
import Base from "@/layouts/Base.astro";
import { projectsMetadata } from "@/lib/metadata";
import { getProjects } from "@/lib/projects";

const projects = await getProjects();
---

<Base metadata={projectsMetadata}>
  <section class="mx-auto w-full max-w-3xl px-6 py-16 lg:px-8">
    <PageTitle>Projects</PageTitle>
    <ProjectList projects={projects} titleAs="h2" />
  </section>
</Base>
