---
import Markdown from "@/components/content/Markdown.astro";
import PostList from "@/components/content/PostList.astro";
import ProjectImage from "@/components/content/ProjectImage.astro";
import MorphTitle from "@/components/motion/MorphTitle.astro";
import JsonLd from "@/components/seo/JsonLd.astro";
import Base from "@/layouts/Base.astro";
import { formatDate } from "@/lib/content";
import { getProjectMetadata } from "@/lib/metadata";
import { getPosts } from "@/lib/posts";
import { getProject, getProjects } from "@/lib/projects";
import { breadcrumbJsonLd, projectJsonLd } from "@/lib/seo";

export async function getStaticPaths() {
  return (await getProjects()).map((entry) => ({
    params: { slug: entry.slug },
  }));
}
const { slug } = Astro.params;
if (!slug) throw new Error("Missing route slug");
const project = await getProject(slug);
if (!project) throw new Error(`Unknown project: ${slug}`);
const metadata = getProjectMetadata(project);
const posts = (await getPosts()).filter((post) => post.project === slug);
---

<Base metadata={metadata}>
  <JsonLd data={projectJsonLd(project)} />
  <JsonLd
    data={breadcrumbJsonLd([
      { name: "Projects", path: "/projects" },
      { name: project.title, path: `/projects/${slug}` },
    ])}
  />
  <article class="py-12 sm:py-16">
    <header class="page-container project-copy space-y-5">
      <MorphTitle
        as="h1"
        title={project.title}
        id={`project-${slug}`}
        class="page-heading"
      />
      <p class="page-description">
        {project.description}
      </p>

      <div class="flex flex-col gap-4 sm:flex-row sm:justify-between sm:gap-6">
        <div class="min-w-0 flex-1 space-y-3">
          <p class="text-xs leading-5 text-muted">
            <time datetime={project.date || undefined}>
              {project.date ? `Published ${formatDate(project.date)}` : "Draft"}
            </time>
          </p>
          {project.tags.length > 0 && (
            <p class="text-xs leading-relaxed text-faint">
              {project.tags.join(" · ")}
            </p>
          )}
        </div>
        {project.link && (
          <a
            href={project.link}
            target="_blank"
            rel="noopener noreferrer"
            class="action-link text-link shrink-0 self-start text-sm"
          >
            View project
          </a>
        )}
      </div>
    </header>

    <ProjectImage project={project} />

    <div class="page-container project-copy">
      <Markdown content={project.body} />
      {posts.length > 0 ? (
        <aside
          aria-labelledby="related-notes"
          class="mt-12 border-t border-border pt-8 sm:mt-16"
        >
          <h2 id="related-notes" class="section-heading">
            Related notes
          </h2>
          <PostList posts={posts} />
        </aside>
      ) : null}
    </div>
  </article>
</Base>

<style>
.project-copy {
  padding-block: 0;
}
</style>
