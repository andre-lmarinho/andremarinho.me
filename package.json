{
  "name": "andremarinho-me",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/generate-images.mjs && astro build",
    "start": "astro preview --port 3100",
    "prepare": "husky",
    "typecheck": "astro check",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lighthouse": "lhci collect && lhci assert",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/og": "0.11.1",
    "@vercel/speed-insights": "^2.0.0",
    "astro": "7.4.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@biomejs/biome": "2.5.15",
    "@lhci/cli": "0.15.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@11.11.0",
  "type": "module"
}
