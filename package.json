{
  "name": "andremarinho-me",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "start": "vite preview --outDir .vercel/output/static --port 3100",
    "prepare": "husky",
    "typecheck": "astro check",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lighthouse": "lhci collect && lhci assert",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.4",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/vercel": "^11.0.16",
    "@upstash/redis": "^1.39.0",
    "@vercel/og": "0.11.1",
    "astro": "7.4.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@biomejs/biome": "2.5.15",
    "@lhci/cli": "0.15.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "^5.0.3"
  }
