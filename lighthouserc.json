{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm start",
      "startServerReadyPattern": "localhost:3100",
      "url": [
        "http://localhost:3100/",
        "http://localhost:3100/about",
        "http://localhost:3100/projects",
        "http://localhost:3100/projects/turistar",
        "http://localhost:3100/posts",
        "http://localhost:3100/posts/engineering-skills-evidence-and-checks"
      ],
      "numberOfRuns": 1,
      "settings": {
        "chromeFlags": "--no-sandbox",
        "emulatedUserAgent": "Mozilla/5.0 (Linux; Android 11; moto g power (2022)) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/136.0.0.0 Mobile Safari/537.36 Chrome-Lighthouse",
        "blockedUrlPatterns": [
          "*/_vercel/insights/*",
          "*/_vercel/speed-insights/*",
          "https://abacus.jasoncameron.dev/*"
        ]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "warn",
          {
            "minScore": 0.9
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 1
          }
        ]
      }
    }
  }
}
